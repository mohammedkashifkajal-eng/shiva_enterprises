# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# URL of the Vite frontend (used for CORS whitelist)
APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Admin Seed (optional) ─────────────────────────────────────────────────────
# Used only when bootstrapping the first admin account via POST /api/auth/register
# Remove or restrict this route in production after seeding.
ADMIN_REGISTER_SECRET=replace_with_a_registration_secret
