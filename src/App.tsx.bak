            </div>

          </div>
        </section>
      </FadeIn>

      {/* Calculator Section */}
      <FadeIn>
        <section id="calculator" className="px-4 py-16 bg-white border-t border-slate-200 md:px-8 md:py-20">
          <div className="max-w-7xl mx-auto">
            <div className="text-center max-w-2xl mx-auto mb-12">
              <div className="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-700 text-[10px] font-mono tracking-wider uppercase">
                Smart Insurance Model
              </div>
              <h3 className="mt-4 text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
                Calculate Your <span className="text-amber-600">School's Savings</span>
              </h3>
              <p className="mt-3 text-sm text-slate-600 leading-relaxed">
