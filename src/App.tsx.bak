              <Link to="/contact" className="transition hover:text-amber-700">Contact</Link>
              <Link to="/request-proposal" className="transition hover:text-amber-700">Request Proposal</Link>
              <a href="http://shivaenterprises.net.in" target="_blank" rel="noopener noreferrer" className="transition hover:text-amber-700">Portal</a>
              <span>© 2026 SHIVA ENTERPRISES. All Rights Reserved.</span>
            </div>

          </div>
        </footer>
      </FadeIn>

      {/* Back to top button */}
      <AnimatePresence>
        {showBackToTop && (
          <motion.button
            key="back-to-top"
            initial={{ opacity: 0, scale: 0.8, y: 20 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            exit={{ opacity: 0, scale: 0.8, y: 20 }}
            transition={{ duration: 0.25 }}
            onClick={scrollToTop}
            aria-label="Back to top"
            className="fixed bottom-6 right-6 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-white shadow-lg transition hover:bg-slate-800 hover:shadow-xl"
          >
            <ArrowUp className="h-4 w-4" />
          </motion.button>
        )}
      </AnimatePresence>

    </div>
  );
}
