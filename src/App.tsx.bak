// Rotating hero slides
type HeroAction = { type: "scroll"; id: string } | { type: "route"; to: string };

interface HeroSlide {
  image: string;
  layout: "cover" | "split";
  title: string;
  description: string;
  primaryCta: { label: string; action: HeroAction };
  secondaryCta: { label: string; action: HeroAction };
  highlights: string[];
}

