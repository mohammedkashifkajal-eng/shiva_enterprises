        </section>
      </FadeIn>

      {/* CTA Section */}
      <FadeIn>
        <section className="px-4 py-16 md:py-20 bg-white border-t border-slate-200">
          <div className="max-w-7xl mx-auto text-center space-y-6">
            <div className="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-[10px] font-mono font-semibold uppercase tracking-wider text-amber-700">
