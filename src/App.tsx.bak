    layout: "cover",
    title: "Modern School Website for Better Learning.",
    description:
      "Showcasing your institution's values while engaging students, parents, and prospective families.",
    primaryCta: { label: "Explore Live Demo", action: { type: "scroll", id: "demo" } },
    secondaryCta: { label: "View Smart Solutions", action: { type: "scroll", id: "services" } },
    highlights: [
      "Smart Attendance",
      "Online Fee Management",
      "Student & Parent Portal",
      "Real-Time Analytics",
    ],
  },
  {
    image: "https://cdn.phototourl.com/free/2026-07-10-95603b16-7e9d-4032-b500-ad787574d57a.jpg",
    layout: "cover",
    title: "Advanced Security for Today's Digital World",
    description:
      "Create a safer, smarter environment with integrated security and identity solutions designed for organizations of every size. Simplify operations, strengthen access control, and gain real-time visibility with technology built for modern security challenges.",
    primaryCta: { label: "Explore Live Demo", action: { type: "scroll", id: "demo" } },
    secondaryCta: { label: "View Smart Solutions", action: { type: "scroll", id: "services" } },
    highlights: [
      "Digital Operations",
      "Access Control",
      "Campus Insights",
      "Secure Identity",
